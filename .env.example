# Model pulled by the one-shot model-init service and used by the API.
OLLAMA_MODEL=qwen2.5:7b

# Local provider is the default; no paid model API is required.
LLM_PROVIDER=ollama

# Optional OpenAI-compatible endpoint. Leave unused for the default local setup.
# This can point to a local server such as LM Studio or vLLM.
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_MODEL=local-model
# ALLOW_REMOTE_LLM=0  # set to 1 only if you intentionally want a non-local endpoint

# service_ops defaults to repository-local synthetic data.
SERVICE_OPS_BACKEND=local
# ALLOW_REMOTE_SERVICE_OPS=0  # set to 1 only for an intentionally configured remote backend
