FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --no-cache-dir fastapi==0.115.6 uvicorn==0.34.0

COPY examples ./examples
COPY domains/service_ops/data ./domains/service_ops/data

EXPOSE 8090

CMD ["uvicorn", "examples.mock_service_api:app", "--host", "0.0.0.0", "--port", "8090"]
